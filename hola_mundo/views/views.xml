<odoo>
    <data>
        <!-- Vista de Lista (Tree) -->
        <record id="view_hola_mundo_tarea_tree" model="ir.ui.view">
            <name>hola.mundo.tarea.tree</name>
            <model>hola.mundo.tarea</model>
            <arch import_type="xml">
                <tree>
                    <field name="name"/>
                    <field name="is_done"/>
                </tree>
            </arch>
        </record>

        <!-- Vista de Formulario -->
        <record id="view_hola_mundo_tarea_form" model="ir.ui.view">
            <name>hola.mundo.tarea.form</name>
            <model>hola.mundo.tarea</model>
            <arch import_type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="is_done"/>
                        </group>
                    </sheet>
                </form>
            </arch>
        </record>

        <!-- Acción para abrir las vistas -->
        <record id="action_hola_mundo_tarea" model="ir.actions.act_window">
            <name>Mis Tareas Hola Mundo</name>
            <res_model>hola.mundo.tarea</res_model>
            <view_mode>tree,form</view_mode>
        </record>

        <!-- Menú Principal y Submenú -->
        <menuitem id="menu_hola_mundo_root" name="Hola Mundo App" web_icon="base,static/description/icon.png"/>
        <menuitem id="menu_hola_mundo_tareas" name="Tareas" parent="menu_hola_mundo_root" action="action_hola_mundo_tarea"/>
    </data>
</odoo>